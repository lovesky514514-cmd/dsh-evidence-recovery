    ".": "./index.js",
    "./ledger": "./ledger.js",
    "./demo": "./demo.js",
    "./client": "./web-client.js"
  },
  "files": [
    "index.js",
    "ledger.js",
    "demo.js",
    "web-host.js",
    "web-access.js",
    "web-client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "DSH_本地试跑.ps1",
    "启动DSH测试.cmd",
    "DSH_接入验收.md",
    "DSH_PLUGIN_CODE_STANDARDS.md",
